# Caddyfile for containerized deployment
http://gtowizard.2d5104a9.sslip.io, http://zenosolver.2d5104a9.sslip.io, http://gto.2d5104a9.sslip.io, http://2d5104a9.sslip.io, http://45.81.4.169.sslip.io, http://:80 {
    # Backend REST endpoints & admin
    handle /api/* {
        reverse_proxy backend:8000
    }
    handle /admin/* {
        reverse_proxy backend:8000
    }

    # Route all other frontend requests to the containerized Vite frontend
    handle {
        reverse_proxy frontend:8089
    }
}
